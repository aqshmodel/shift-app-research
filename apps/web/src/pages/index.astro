---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import ContextIcon from '../components/ContextIcon.astro';
import {getResearch} from '../lib/data';
import {categoryInfo} from '../lib/catalog';
const data=await getResearch(Astro.locals).scope();
const days=['月','火','水','木','金','土','日'];
const patterns=[[1,1,0,2,2,0,1],[0,2,2,1,0,1,1],[2,0,1,0,1,2,2]];
---
<Base title="シフトづくりサービスを、根拠とともに探せます">
 <section class="hero container">
  <div class="hero-copy">
   <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> SHIFT RESEARCH <span class="eyebrow-date">2026.10.11</span></p>
   <h1>現場に合うサービスを、<br /><span>根拠とともに探せます。</span></h1>
   <p class="hero-description">勤務表の自動作成から、様式9、料金、解約時のデータ出力まで。公開資料の根拠と未確認事項を、同じ画面で比較できます。</p>
   <div class="hero-actions"><a class="button" href="/products/">サービスを探す <span aria-hidden="true">↗</span></a><a class="text-link" href="/compare/">比較から始める <span aria-hidden="true">→</span></a></div>
   <p class="free-note"><span class="status-indicator" aria-hidden="true"></span> 無料・会員登録不要でご利用いただけます。</p>
  </div>
  <aside class="research-board" aria-label="調査の収録件数">
   <div class="board-top"><span>RESEARCH NOTE</span><span>2026 / 10</span></div>
   <div class="board-main"><div><span class="small muted">調査対象</span><p class="research-number"><strong>{data.products}</strong><span>サービス</span></p></div><a class="board-link" href="/methodology/" aria-label="調査の範囲を確認する"><span aria-hidden="true">↗</span></a></div>
   <div class="shift-illustration" aria-hidden="true"><div class="calendar-header"><span>SHIFT PLANNING</span><span>イメージ</span></div><div class="calendar-days">{days.map(d=><span>{d}</span>)}</div><div class="calendar-grid">{patterns.flatMap((row,ri)=>row.map((cell,i)=><span class:list={['calendar-cell','cell-'+cell,{'cell-focus':ri===1&&i===3}]}>{cell===0?'—':cell===1?'日':'夜'}</span>))}</div></div>
   <div class="board-stats"><div><strong>{data.document_observations.toLocaleString()}</strong><span>件の調査記録</span></div><div><strong>{data.research_documents}</strong><span>件の参照文書</span></div></div>
   <p class="board-note">2026年10月11日現在の調査内容です。</p>
  </aside>
 </section>
 <section class="container search-home" aria-label="製品検索">
  <SearchForm compact />
  <div class="quick-search"><span>確認したいことから</span><a href="/products/?feature=B01">勤務表の自動作成 <span aria-hidden="true">↗</span></a><a href="/products/?feature=J05">様式9の計算根拠 <span aria-hidden="true">↗</span></a><a href="/products/?feature=N02">認証の確認範囲 <span aria-hidden="true">↗</span></a><a href="/products/?feature=M08">解約時のデータ出力 <span aria-hidden="true">↗</span></a></div>
 </section>
 <section class="container section contexts">
  <div class="section-head"><div><p class="eyebrow">01 / BY CONTEXT</p><h2>現場から探せます。</h2></div><a class="text-link" href="/products/">すべてのサービスを見る <span aria-hidden="true">↗</span></a></div>
  <div class="category-grid">{Object.entries(categoryInfo).map(([id,c],i)=><a class="category-card" href={'/categories/'+id+'/'}><div class="category-card-top"><span class="category-number">0{i+1}</span><span class="category-arrow" aria-hidden="true">↗</span></div><ContextIcon kind={id}/><h3>{c.name}</h3><p>{c.checks[0]}<br />{c.checks[1]}</p><span class="category-cta">選び方・サービスを確認する <span aria-hidden="true">→</span></span></a>)}</div>
 </section>
 <section class="research-strip">
  <div class="container evidence-intro"><div><p class="eyebrow">02 / READ THE EVIDENCE</p><h2>確認できた範囲まで、<br />丁寧にお伝えします。</h2><p>出典と適用条件を、一緒にご覧いただけます。</p></div><div><p>様式9の出力と算式の検算、MFAの利用と管理者への強制は、それぞれ確認範囲が異なります。公開資料で確認できたことと、まだ確認が必要なことを分けて掲載しています。</p><div class="evidence-legend"><span><i class="legend-dot documented"></i>資料で確認</span><span><i class="legend-dot planned"></i>提供予定</span><span><i class="legend-dot disputed"></i>資料に不一致</span><span><i class="legend-dot unknown"></i>記載未確認</span></div><div class="inline-links"><a href="/methodology/">確認状況の読み方 <span aria-hidden="true">↗</span></a><a href="/references/form-9/">様式9の参照資料 <span aria-hidden="true">↗</span></a></div></div></div>
 </section>
 <section class="container mcp-feature section">
  <div><p class="eyebrow">03 / FOR PEOPLE & AI</p><h2>AIと相談しながら探せます。</h2><p>Web MCPに対応しています。対応するブラウザ・AIから、検索・比較・調査記録を取得していただけます。情報の時点、料金条件、未確認事項もAIへ伝わります。</p><a class="text-link" href="/webmcp/">AIと探すための利用方法 <span aria-hidden="true">↗</span></a></div>
  <div class="mcp-conversation"><div class="conversation-top"><span class="status-indicator" aria-hidden="true"></span><span>人とAIで、同じ資料を確認できます。</span><span class="mcp-badge">Web MCP</span></div><div class="conversation-question"><span class="conversation-label">相談の例</span><p>医療向けのサービスで、様式9の計算根拠と解約時の出力を比較してください。</p></div><div class="conversation-data"><span class="conversation-label">AIが取得できる情報</span><div><span>製品・料金</span><span>確認状況</span><span>出典URL</span><span>調査基準日</span></div></div><p class="small muted">ご利用には、ブラウザとAIのWeb MCP対応が必要です。</p></div>
 </section>
</Base>
