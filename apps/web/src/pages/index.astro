---
import Base from '../layouts/Base.astro';
import HomeDirectory from '../components/HomeDirectory.astro';
import '../styles/home-directory.css';
import ContextIcon from '../components/ContextIcon.astro';
import {getResearch} from '../lib/data';
import {categoryInfo} from '../lib/catalog';
import {buildDirectory, readDirectoryFilters} from '../lib/home-directory.mjs';
const research = getResearch(Astro.locals);
const catalog = await research.catalog();
const data = await research.scope();
let filters; let error = '';
try { filters = readDirectoryFilters(Astro.url.searchParams); }
catch { error = '検索条件を確認してください。条件を解除して、もう一度お探しください。'; Astro.response.status = 400; filters = readDirectoryFilters(new URLSearchParams()); }
const result = buildDirectory(catalog, filters);
---
<Base title="シフト管理・作成サービスを、用途や機能から探せます" description="シフト管理・作成サービス50製品を、医療・介護・店舗などの用途と必要な機能で絞り込めます。ロゴ付きの一覧から、勤務表の自動割当、様式9、料金や利用条件を比較できます。無料・会員登録不要。" structured={{'@type':'CollectionPage',mainEntity:{'@type':'ItemList',numberOfItems:result.total,itemListElement:result.products.map((p:any,i:number)=>({'@type':'ListItem',position:result.start+i+1,name:p.name,url:'https://shift.aqsh.co.jp/products/'+p.slug+'/'}))}}}>
 <section class="home-intro container">
  <div>
   <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> SHIFT RESEARCH <span class="eyebrow-date">{data.as_of_date.replaceAll('-', '.')}</span></p>
   <h1><span class="home-service-title">シフト管理・作成<span class="home-service-action">サービスを</span></span><span>用途や機能から探せます。</span></h1>
   <p class="home-lead">サービス名を知らなくても、条件に合う候補を絞り込めます。</p>
   <p class="free-note"><span class="status-indicator" aria-hidden="true"></span> 無料・会員登録不要でご利用いただけます。</p>
  </div>
  <aside class="home-scope" aria-label="調査の収録件数"><p class="research-number"><strong>{data.products}</strong><span>サービスを収録</span></p><p><strong>{data.document_observations.toLocaleString()}</strong>件の調査記録 / <strong>{data.research_documents}</strong>件の参照文書</p><a href="/methodology/">調査の範囲をご確認いただけます <span aria-hidden="true">↗</span></a></aside>
 </section>
 <HomeDirectory result={result} error={error} asOfDate={data.as_of_date}/>
 <section class="container section contexts">
  <div class="section-head"><div><p class="eyebrow">CHOOSING A SERVICE</p><h2>比較のポイントもご案内します。</h2></div><a class="text-link" href="/products/">すべてのサービスを見る <span aria-hidden="true">↗</span></a></div>
  <div class="category-grid">{Object.entries(categoryInfo).map(([id,c],i)=><a class="category-card" href={'/categories/'+id+'/'}><div class="category-card-top"><span class="category-number">0{i+1}</span><span class="category-arrow" aria-hidden="true">↗</span></div><ContextIcon kind={id}/><h3>{c.name}</h3><p>{c.checks[0]}<br />{c.checks[1]}</p><span class="category-cta">選び方・サービスを確認する <span aria-hidden="true">→</span></span></a>)}</div>
 </section>
 <section class="research-strip">
  <div class="container evidence-intro"><div><p class="eyebrow">02 / READ THE EVIDENCE</p><h2>確認できた範囲まで、<br />丁寧にお伝えします。</h2><p>出典と適用条件を、一緒にご覧いただけます。</p></div><div><p>様式9の出力と算式の検算、MFAの利用と管理者への強制は、それぞれ確認範囲が異なります。公開資料で確認できたことと、まだ確認が必要なことを分けて掲載しています。</p><div class="evidence-legend"><span><i class="legend-dot documented"></i>資料で確認</span><span><i class="legend-dot planned"></i>提供予定</span><span><i class="legend-dot disputed"></i>資料に不一致</span><span><i class="legend-dot unknown"></i>記載未確認</span></div><div class="inline-links"><a href="/methodology/">確認状況の読み方 <span aria-hidden="true">↗</span></a><a href="/references/form-9/">様式9の参照資料 <span aria-hidden="true">↗</span></a></div></div></div>
 </section>
 <section class="container mcp-feature section">
  <div><p class="eyebrow">03 / FOR PEOPLE & AI</p><h2>AIと相談しながら探せます。</h2><p>Web MCPに対応しています。対応するブラウザ・AIから、検索・比較・調査記録を取得していただけます。情報の時点、料金条件、未確認事項もAIへ伝わります。</p><a class="text-link" href="/webmcp/">AIと探すための利用方法 <span aria-hidden="true">↗</span></a></div>
  <div class="mcp-conversation"><div class="conversation-top"><span class="status-indicator" aria-hidden="true"></span><span>人とAIで、同じ資料を確認できます。</span><span class="mcp-badge">Web MCP</span></div><div class="conversation-question"><span class="conversation-label">相談の例</span><p>医療向けのサービスで、様式9の計算方法と解約時の出力を比較してください。</p></div><div class="conversation-data"><span class="conversation-label">AIが取得できる情報</span><div><span>製品・料金</span><span>確認状況</span><span>出典URL</span><span>調査基準日</span></div></div><p class="small muted">ご利用には、ブラウザとAIのWeb MCP対応が必要です。</p></div>
 </section>
</Base>
