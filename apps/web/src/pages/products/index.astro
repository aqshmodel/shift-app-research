---
import Base from '../../layouts/Base.astro';import SearchForm from '../../components/SearchForm.astro';import ProductCard from '../../components/ProductCard.astro';import {search} from '../../lib/data';
const input=Object.fromEntries(Astro.url.searchParams);let result:any;let error='';
try{result=await search({...input,limit:50});}catch{error='検索条件を確認してください。';Astro.response.status=400;result=await search({limit:50});}
---
<Base title="シフト管理・自動作成サービス一覧｜50製品を検索・比較" breadcrumbs={[{name:'トップ',url:'/'},{name:'製品一覧',url:'/products/'}]} noindex={Boolean(error||Astro.url.search)}>
 <section class="container page-heading"><p class="eyebrow">PRODUCT DIRECTORY</p><h1>製品を探す</h1><p>医療・介護・店舗向けのシフトサービスを、公開資料の確認範囲で探せます。</p><p class="small muted">2026年10月11日現在の調査内容。名前順で表示しています。</p></section>
 <section class="container"><SearchForm filters={result.filters}/>{error&&<p class="notice" role="alert">{error}</p>}<p class="filter-help">項目を指定した場合は、その範囲を資料で確認した製品を表示します。「提供予定」「資料に不一致」も選べます。管理者MFAの強制や制度適合の保証とは区別してください。</p></section>
 <section class="container section"><div class="section-head"><h2 class="results-title">{result.total}<span>件の製品</span></h2><a href="/compare/">比較する製品を選ぶ →</a></div>{result.products.length?<div class="product-grid">{result.products.map((p:any)=><ProductCard product={p}/>)}</div>:<div class="empty"><h2>この条件の製品は見つかりませんでした</h2><p>記載がまだ確認できていない場合もあります。条件を減らしてお探しください。</p><a class="button" href="/products/">すべての製品を見る</a></div>}</section>
 <noscript><p class="container notice">検索・詳細はそのまま利用できます。比較ページで2〜4製品を選択してください。</p></noscript>
</Base>
