---
import Base from '../../layouts/Base.astro';import {introduction} from '../../lib/service-copy';import Assessment from '../../components/Assessment.astro';import Prices from '../../components/Prices.astro';import {getResearch} from '../../lib/data';const {productBySlug,evidence}=getResearch(Astro.locals);import {categoryInfo,methodLabels,safeUrl,safeImage,formatResearchDate} from '../../lib/catalog';
import {assessmentGroups,displayText} from '../../lib/presentation.mjs';
import {stateLabels} from '../../lib/catalog';
import {summarizePrice} from '../../lib/price-summary.mjs';
import ResearchRecord from '../../components/ResearchRecord.astro';
import {detailModifiedDate} from '../../lib/publication-dates.mjs';
const p=await productBySlug(Astro.params.slug||'');if(!p)Astro.response.status=404;
const asOf=formatResearchDate(p?.as_of_date);
const price=p?summarizePrice(p.prices,p.assessments?.find((a:any)=>a.id==='P01')):null;
const groups=p?assessmentGroups(p.assessments):[];
const records=p?await evidence({id:p.id},{all:true}):null;
const modified=p?detailModifiedDate(records?.modified_on):null;
const application=p?{'@type':'SoftwareApplication','@id':`https://shift.aqsh.co.jp/products/${p.slug}/#software`,name:p.name,url:p.official_url,applicationCategory:'BusinessApplication',description:p.summary,mainEntityOfPage:`https://shift.aqsh.co.jp/products/${p.slug}/`}:null;
---
<Base title={p?`${p.name}の機能・料金・確認状況`:'製品が見つかりません'} description={p?`${p.name}の公開資料を調査。${introduction(p)} 料金条件、公開資料で確認した機能と、契約前の確認事項を掲載。${asOf}現在。`:undefined} noindex={!p} modified={modified} structured={application} breadcrumbs={[{name:'トップ',url:'/'},{name:'製品一覧',url:'/products/'},{name:p?.name||'製品なし',url:Astro.url.pathname}]}>
{p?<>
 <section class="container detail-heading">
  <div class="detail-logo">{p.logo?.url&&safeImage(p.logo.url)?<img class="vendor-logo" src={safeImage(p.logo.url)} alt={p.logo.brand+' ロゴ'} width="240" height="64" referrerpolicy="no-referrer"/>:<span class="logo-fallback" aria-hidden="true">{p.name.slice(0,1)}</span>}</div>
  <h1>{p.name}</h1>
  <div class="detail-price"><dl><dt>料金</dt><dd><strong>{price?.label}</strong>{price?.note&&<span>{price.note}</span>}</dd></dl><a href="#prices">料金・契約条件を見る <span aria-hidden="true">↓</span></a></div>
  {p.vendor&&<p class="vendor-name">{p.vendor}</p>}
  <p class="detail-lead">{introduction(p)}</p>
  <div class="category-list">{p.categories.map((c:string)=><a href={'/categories/'+c+'/'}>{categoryInfo[c].name}</a>)}</div>
  <div class="heading-actions"><a class="button" href={safeUrl(p.official_url)} data-vendor-id={p.id} rel="noopener noreferrer">各社の公式ページ ↗</a><button class="compare-add button secondary" data-id={p.id} data-label={p.name} aria-pressed="false">比較に追加</button></div>
  <p class="small muted">{p.official_note}</p>
  <div class="detail-meta"><p>{p.region==='domestic'?'国内':'海外'}の調査対象 · {asOf}現在の調査内容です。</p><p>実動作・独立性能試験は未実施です。</p></div>
 </section>
 <nav class="detail-nav container" aria-label="製品内メニュー"><a href="#scope">提供範囲</a><a href="#features">機能・利用条件</a><a href="#prices">料金</a><a href="#questions">契約前の確認</a><a href="#records">調査記録</a></nav>
 <div class="container detail-layout"><article>
  <section id="scope" class="detail-section"><h2>この調査の提供範囲</h2><dl class="scope-dl"><div><dt>提供単位</dt><dd>{p.offering.edition}{p.offering.module_name&&` / ${p.offering.module_name}`}</dd></div><div><dt>参照販売地域</dt><dd>{p.offering.sales_region||'未確認'}</dd></div><div><dt>製品の版</dt><dd>{p.offering.release_version||'版番号未確認'}</dd></div><div><dt>確認時の注意点</dt><dd>{p.offering.scope_note}</dd></div></dl><p class="notice">公開資料の記載を確認した範囲です。設問の全要件、実動作、施設ごとの制度適合を保証するものではありません。</p></section>
  <section id="features" class="detail-section">
   <div class="section-head"><h2>機能と利用条件</h2><a href="/methodology/">表示の見方 ↗</a></div>
   <p class="small muted feature-note">公開資料に記載のある項目を掲載しています。掲載のない項目が非対応とは限りません。実動作は未検証です。</p>
   {groups.length?<><nav class="feature-index" aria-label="機能の目次">{groups.map(group=><a href={'#features-'+group.id}>{group.name}</a>)}</nav>{groups.map(group=><section class="feature-group" id={'features-'+group.id} aria-labelledby={'features-'+group.id+'-title'}><h3 id={'features-'+group.id+'-title'}>{group.name}</h3><div class="feature-list">{group.items.map((a:any)=><article class="feature-item" data-criterion={a.id} data-state={a.status}><div class="feature-item-heading"><h4>{displayText(a.label)}</h4><span class={'state state-'+a.status}>{stateLabels[a.status]}</span></div><Assessment assessment={a} showStatus={false}/></article>)}</div></section>)}</>:<p>現在、掲載できる機能の情報を整理しています。詳しい内容は公式ページをご確認ください。</p>}
  </section>
  <section id="prices" class="detail-section"><h2>料金と契約条件</h2><Prices prices={p.prices}/></section>
  <section id="questions" class="detail-section"><h2>契約前に確認したいこと</h2>{p.open_questions.length?<ul class="question-list">{p.open_questions.map((q:any)=><li><p>{displayText(q.question)}</p><span class="small">確認に使うもの：{methodLabels[q.required_method]||q.required_method}</span></li>)}</ul>:<p>導入前には、対象プランや利用条件を販売元へご確認ください。</p>}<p class="small muted">資料や見積を入手しただけで、実動作試験や解約データの復元試験を完了とは扱いません。</p></section>
  <section id="records" class="detail-section" data-evidence-id={p.id}><h2>調査記録と履歴</h2><p class="small muted">採用した記録、過去・補足の記録、分類訂正の対象を含みます。最新の判断は上の機能欄をご覧ください。</p><div id="evidence-records">{records?.records.slice(0,10).map((r:any)=><ResearchRecord record={r}/>)}{records&&records.records.length>10&&<details class="record-archive"><summary>残り{records.records.length-10}件の調査記録を見る</summary>{records.records.slice(10).map((r:any)=><ResearchRecord record={r}/>)}</details>}</div><p class="small">全{records?.total}記録 · <a href={'/api/evidence/?id='+p.id}>構造化データを取得</a></p></section>
 </article><section class="detail-guidance" aria-labelledby="comparison-guide-title"><p class="eyebrow">CHECK BEFORE CHOOSING</p><h2 id="comparison-guide-title">比較の前に</h2><p>同じ「対応」でも、地域・プラン・追加機能で利用条件が変わります。</p><a href="/compare/">他の製品と比較する →</a><a href="/references/form-9/">様式9の参照資料 →</a><a href="/webmcp/">AIから情報を取得する →</a><p class="small">掲載版 {p.snapshot_id}<br />ロゴは{p.logo?.kind==='service'?'サービス':'会社'}の公式掲載画像です。商標等は各権利者に帰属します。</p></section></div>
</>:<section class="container empty"><h1>製品が見つかりませんでした</h1><p>製品一覧からお探しください。</p><a class="button" href="/products/">製品一覧へ</a></section>}
</Base>
