---
import Base from '../../layouts/Base.astro';import Assessment from '../../components/Assessment.astro';import Prices from '../../components/Prices.astro';import {productBySlug,evidence} from '../../lib/data';import {categoryInfo,methodLabels,safeUrl,safeImage} from '../../lib/catalog';
const p=await productBySlug(Astro.params.slug||'');if(!p)Astro.response.status=404;
const records=p?await evidence({id:p.id}):null;
const application=p?{'@type':'SoftwareApplication','@id':`https://shift.aqsh.co.jp/products/${p.slug}/#software`,name:p.name,url:p.official_url,applicationCategory:'BusinessApplication',description:p.summary,mainEntityOfPage:`https://shift.aqsh.co.jp/products/${p.slug}/`}:null;
---
<Base title={p?`${p.name}の機能・料金・確認状況`:'製品が見つかりません'} description={p?`${p.name}の公開資料を調査。${p.summary} 料金条件、機能の根拠、未確認事項を掲載。2026年10月11日現在。`:undefined} noindex={!p} structured={application} breadcrumbs={[{name:'トップ',url:'/'},{name:'製品一覧',url:'/products/'},{name:p?.name||'製品なし',url:Astro.url.pathname}]}>
{p?<>
 <section class="container detail-heading"><div><p class="eyebrow">PRODUCT RESEARCH / {p.region==='domestic'?'JAPAN':'OVERSEAS'}</p><h1>{p.name}</h1><p class="vendor-name">{p.vendor||'提供法人の詳細は下の調査記録を参照'}</p><p class="detail-lead">{p.summary}</p><div class="category-list">{p.categories.map((c:string)=><a href={'/categories/'+c+'/'}>{categoryInfo[c].name}</a>)}</div><div class="heading-actions"><a class="button" href={safeUrl(p.official_url)} rel="noopener noreferrer">各社の公式ページ ↗</a><button class="compare-add button secondary" data-id={p.id} data-label={p.name} aria-pressed="false">比較に追加</button></div><p class="small muted">{p.official_note}</p></div><div class="detail-logo">{p.logo&&<img class="vendor-logo" src={safeImage(p.logo.url)} alt={p.logo.brand+' ロゴ'} width="240" height="90" referrerpolicy="no-referrer"/>}<span>2026年10月11日現在の調査内容</span><span>実動作・独立性能試験は未実施</span></div></section>
 <nav class="detail-nav container" aria-label="製品内メニュー"><a href="#scope">提供範囲</a><a href="#features">機能・根拠</a><a href="#prices">料金</a><a href="#questions">未確認事項</a><a href="#records">調査記録</a></nav>
 <div class="container detail-layout"><article>
  <section id="scope" class="detail-section"><h2>この調査の提供範囲</h2><dl class="scope-dl"><div><dt>提供単位</dt><dd>{p.offering.edition}{p.offering.module_name&&` / ${p.offering.module_name}`}</dd></div><div><dt>参照販売地域</dt><dd>{p.offering.sales_region||'未確認'}</dd></div><div><dt>製品の版</dt><dd>{p.offering.release_version||'版番号未確認'}</dd></div><div><dt>留保</dt><dd>{p.offering.scope_note}</dd></div></dl><p class="notice">公開資料の記載を確認した範囲です。設問の全要件、実動作、施設ごとの制度適合を保証するものではありません。</p></section>
  <section id="features" class="detail-section"><div class="section-head"><h2>機能と、確認した根拠</h2><a href="/methodology/">状態の読み方 ↗</a></div>{p.assessments.map((a:any)=><details class="feature-detail" open={['B01','B07','J04','J05','J06','N02','M08'].includes(a.id)}><summary>{a.label}<span class={'state-dot '+a.status} aria-hidden="true"></span></summary><Assessment assessment={a}/></details>)}</section>
  <section id="prices" class="detail-section"><h2>料金と契約条件</h2><Prices prices={p.prices}/></section>
  <section id="questions" class="detail-section"><h2>まだ確認が必要なこと</h2>{p.open_questions.length?<ul class="question-list">{p.open_questions.map((q:any)=><li><p>{q.question}</p><span class="small">次の確認：{methodLabels[q.required_method]||q.required_method}</span></li>)}</ul>:<p>個別の重要課題は現在整理中です。機能の「記載未確認」は上の各項目で確認できます。</p>}<p class="small muted">資料や見積を入手しただけで、実動作試験や解約データの復元試験を完了とは扱いません。</p></section>
  <section id="records" class="detail-section" data-evidence-id={p.id}><h2>調査記録と履歴</h2><p class="small muted">採用した記録、過去・補足の記録、分類訂正の対象を含みます。最新の判断は上の機能欄をご覧ください。</p><div id="evidence-records">{records?.records.map((r:any)=><article class="record"><p class="small">{r.label} · {r.evidence_role==='accepted'?'現在の採用根拠':r.evidence_role==='conflicting'?'資料に不一致':r.evidence_role==='rejected'?'採用除外・訂正対象':'過去・補足'}</p><p>{r.summary}</p>{r.sources.map((s:any)=><p class="small"><a href={safeUrl(s.url)} rel="noopener noreferrer">{s.title} ↗</a> · {s.locator} · 取得 {s.retrieved_on}</p>)}<details><summary>適用範囲・留保</summary><p>{r.scope?.scope}</p><p>{r.limitations}</p></details></article>)}</div>{records?.has_more&&<button id="load-evidence" class="button secondary" type="button" data-id={p.id} data-page="2">続きを表示</button>}<p class="small">全{records?.total}記録 · <a href={'/api/evidence/?id='+p.id}>構造化データを取得</a></p></section>
 </article><aside class="detail-sidebar"><p class="eyebrow">CHECK BEFORE CHOOSING</p><h2>比較の前に</h2><p>同じ「対応」でも、地域・プラン・追加機能で利用条件が変わります。</p><a href="/compare/">他の製品と比較する →</a><a href="/references/form-9/">様式9の参照資料 →</a><a href="/webmcp/">AIから情報を取得する →</a><p class="small">掲載版 {p.snapshot_id}<br />ロゴは{p.logo?.kind==='service'?'サービス':'会社'}の公式掲載画像です。商標等は各権利者に帰属します。</p></aside></div>
</>:<section class="container empty"><h1>製品が見つかりません</h1><p>製品一覧からお探しください。</p><a class="button" href="/products/">製品一覧へ</a></section>}
</Base>
