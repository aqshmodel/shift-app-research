---
import Base from '../layouts/Base.astro';import Assessment from '../components/Assessment.astro';import {getResearch} from '../lib/data';const {catalog,compare}=getResearch(Astro.locals);
const all=await catalog();
const raw=Astro.url.searchParams.getAll('products').flatMap(v=>v.split(',')).filter(Boolean);
let result:any=null;let error='';
if(raw.length){try{result=await compare(raw);}catch{error='異なる製品を2〜4件選択してください。';Astro.response.status=400;}}
const cols=result?.products||[];
---
<Base title="シフトサービスを比較｜機能・料金・根拠" noindex breadcrumbs={[{name:'トップ',url:'/'},{name:'製品比較',url:'/compare/'}]}>
 <section class="container page-heading"><p class="eyebrow">SIDE BY SIDE</p><h1>根拠と条件を比較できます。</h1><p>2〜4製品の機能と確認範囲を比較します。料金は提供条件ごとに表示します。</p><p class="small muted">2026年10月11日現在の調査内容です。実動作・性能試験は未実施です。</p></section>
 <form class="container compare-form" action="/compare/" method="get">{[0,1,2,3].map(i=><label>製品{i+1}{i<2?'（必須）':'（任意）'}<select name="products" required={i<2}><option value="">製品を選択</option>{all.map((p:any)=><option value={p.id} selected={raw[i]===p.id}>{p.name}</option>)}</select></label>)}<button class="button" type="submit">比較する</button></form>
 {error&&<p class="container notice" role="alert">{error}</p>}
 {result?<section class="container section"><div class="section-head"><h2>{cols.length}製品の比較</h2><label class="difference-toggle"><input type="checkbox" id="differences-only"/> 違いのある項目だけ</label></div><p class="small muted">横にスクロールして製品ごとの内容を確認できます。「記載未確認」は非対応ではありません。</p><div class="comparison-scroll" tabindex="0" aria-label="製品比較表（横スクロール）"><table class="comparison-table"><thead><tr><th scope="col">比較項目</th>{cols.map((p:any)=><th scope="col"><a href={'/products/'+p.slug+'/'}>{p.name}</a><p class="small">{p.vendor}</p><a class="small" href={p.official_url} data-vendor-id={p.id} rel="noopener noreferrer">公式ページ ↗</a></th>)}</tr></thead><tbody><tr><th scope="row">提供範囲</th>{cols.map((p:any)=><td><p>{p.offering.edition}</p><p class="small">{p.offering.scope_note}</p></td>)}</tr><tr><th scope="row">料金</th>{cols.map((p:any)=><td>{p.prices.length?p.prices.slice(0,4).map((price:any)=><div class="compare-price"><strong>{price.plan_name}</strong><p>{price.amount_status==='known'?`${price.currency} ${price.unit_amount_decimal} / ${price.billable_unit} / ${price.recurrence_months||'単発'}か月`:'個別見積・金額未確認'}</p><p class="small">{price.conditions?.notes}</p><p class="small">{price.current_evidence_role==='accepted'?'採用根拠':'過去・補足'} · 税{price.tax_status==='inclusive'?'込':price.tax_status==='exclusive'?'別':'区分未確認'}</p></div>):<p>金額未確認。0円ではありません。</p>}<a href={'/products/'+p.slug+'/#prices'}>全料金・条件を見る →</a></td>)}</tr>{result.criteria.map((cid:string)=>{const cells=cols.map((p:any)=>p.assessments.find((a:any)=>a.id===cid));const signatures=cells.map((a:any)=>JSON.stringify([a?.status,a?.findings.map((f:any)=>f.summary)]));const different=new Set(signatures).size>1;return <tr data-different={different?'true':'false'}><th scope="row">{cells.find(Boolean)?.label||cid}</th>{cells.map((a:any)=><td>{a?<Assessment assessment={a} compact/>:<><span class="state">記載未確認</span><p>非対応という判断ではありません。</p></>}</td>)}</tr>;})}</tbody></table></div><p class="notice">資料の記載範囲を比較する表です。実動作の合格判定や推奨順位ではありません。各製品の詳細で留保と全出典を確認してください。</p></section>:<section class="container empty"><h2>比較する製品を選んでください</h2><p>上の選択欄、または製品一覧の「比較に追加」から選べます。</p><a class="button secondary" href="/products/">製品一覧から探す →</a></section>}
</Base>
