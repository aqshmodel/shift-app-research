---
import Base from '../../layouts/Base.astro';import ProductCard from '../../components/ProductCard.astro';import {categoryInfo} from '../../lib/catalog';import {getResearch} from '../../lib/data';const {search}=getResearch(Astro.locals);
const slug=Astro.params.slug||'';const category=categoryInfo[slug];if(!category)Astro.response.status=404;const result=category?await search({category:slug,limit:50}):{products:[],total:0};
---
<Base title={category?`${category.name}のシフト管理・自動作成サービス`:'用途が見つかりません'} description={category?.intro} noindex={!category} breadcrumbs={[{name:'トップ',url:'/'},{name:category?.name||'用途なし',url:Astro.url.pathname}]} structured={category?{'@type':'CollectionPage',name:category.name+'のシフトサービス',url:'https://shift.aqsh.co.jp'+Astro.url.pathname,mainEntity:{'@type':'ItemList',itemListElement:result.products.map((p:any,i:number)=>({'@type':'ListItem',position:i+1,name:p.name,url:'https://shift.aqsh.co.jp/products/'+p.slug+'/'}))}}:null}>
 {category?<><section class="container page-heading"><p class="eyebrow">BY CONTEXT</p><h1>{category.name}の<br />シフトサービス</h1><p class="category-intro">{category.intro}</p><p class="small muted">2026年10月11日現在の調査内容です。対象業態の分類は制度適合の認定ではありません。</p></section><section class="container category-guide"><h2>選ぶ前に確認する3つのこと</h2><ol>{category.checks.map(s=><li>{s}</li>)}</ol><a href={'/products/?category='+slug}>さらに機能・確認状況で絞り込む →</a></section><section class="container section"><div class="section-head"><h2>{result.total}件の調査対象</h2><a href="/methodology/">調査方法を見る ↗</a></div><div class="product-grid">{result.products.map((p:any)=><ProductCard product={p}/>)}</div></section></>:<section class="container empty"><h1>用途が見つかりません</h1><a href="/products/">製品一覧へ</a></section>}
</Base>
