---
import Base from '../../layouts/Base.astro';import ProductCard from '../../components/ProductCard.astro';import CategoryGuide from '../../components/CategoryGuide.astro';import {categoryGuides,GUIDE_UPDATED} from '../../lib/category-guides';import {categoryInfo,SITE,formatResearchDate} from '../../lib/catalog';import {getResearch} from '../../lib/data';const {search,scope}=getResearch(Astro.locals);
const slug=Astro.params.slug||'';const category=categoryInfo[slug];if(!category)Astro.response.status=404;const result=category?await search({category:slug,limit:50}):{products:[],total:0};
const guide=categoryGuides[slug];const asOfDate=category?(await scope()).as_of_date:undefined;
---
<Base title={guide?.title||'用途が見つかりません'} description={guide?.description} noindex={!category} breadcrumbs={[{name:'トップ',url:'/'},{name:category?.name||'用途なし',url:Astro.url.pathname}]} structured={category?{'@type':'CollectionPage',name:guide.title,url:SITE+Astro.url.pathname,dateModified:GUIDE_UPDATED,author:{'@id':SITE+'/#publisher'},mainEntity:{'@type':'ItemList',itemListElement:result.products.map((p:any,i:number)=>({'@type':'ListItem',position:i+1,name:p.name,url:SITE+'/products/'+p.slug+'/'}))}}:null}>
 {category?<><section class="container page-heading guide-heading"><p class="eyebrow">BY CONTEXT / 選び方と比較</p><h1>{guide.title}</h1><p class="category-intro">{category.intro}</p><p class="small muted">{formatResearchDate(asOfDate)}現在の調査内容です。対象業態の分類は制度適合の認定ではありません。</p><div class="guide-heading-links"><a href="#steps">選び方を読む <span aria-hidden="true">↓</span></a><a href="#products">{result.total}件のサービスを見る <span aria-hidden="true">↓</span></a></div></section><CategoryGuide guide={guide} slug={slug} asOfDate={asOfDate}/><section class="container section" id="products" aria-labelledby="products-title"><div class="section-head"><div><p class="eyebrow">06 / CATALOG</p><h2 id="products-title">{result.total}件の調査対象</h2></div><a href={'/products/?category='+slug}>機能・確認状況で絞り込む <span aria-hidden="true">↗</span></a></div><div class="product-grid">{result.products.map((p:any)=><ProductCard product={p}/>)}</div></section></>:<section class="container empty"><h1>用途が見つかりません</h1><a href="/products/">製品一覧へ</a></section>}
</Base>
