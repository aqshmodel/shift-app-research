{
  "name": "aqsh-shift-research-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "wrangler types worker-configuration.d.ts && astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "wrangler dev --port 4322",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "lighthouse": "13.5.0",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
